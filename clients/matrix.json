    },
    "golang": {
      "dir": "clients/golang",
      "sentinel": "go.mod"
    },
    "java": {
      "dir": "clients/java",
      "sentinel": "pom.xml"
    },
    "kotlin": {
      "dir": "clients/kotlin",
      "sentinel": "build.gradle.kts"
    },
    "php": {
      "dir": "clients/php",
